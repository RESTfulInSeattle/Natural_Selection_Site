{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/naturalselection-site"
    },
    {
      "name": "Next.js: debug client-side (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/naturalselection-site"
    },
    {
      "name": "Next.js: debug client-side (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/naturalselection-site"
    },
    {
      "name": "Next.js: attach to Node process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}/naturalselection-site"
    }
  ],
  "compounds": [
    {
      "name": "Next.js: Full Stack (Server + Edge)",
      "configurations": [
        "Next.js: debug server-side",
        "Next.js: debug client-side (Edge)"
      ]
    },
    {
      "name": "Next.js: Full Stack (Server + Chrome)",
      "configurations": [
        "Next.js: debug server-side",
        "Next.js: debug client-side (Chrome)"
      ]
    }
  ]
}
